#!/system/bin/sh
# Play Detach - command line tool
# Copyright 2026 Tears Burn (nikakvo). Licensed under the Apache License 2.0.
# Based on zygisk-detach by j-hc (https://github.com/j-hc/zygisk-detach).

# The Android shell (mksh) starts every helper as a separate program, which
# is slow on phones. If the root manager's busybox is there, run under its
# shell instead, with its built-in helpers (several times faster).
# PD_BB marks the second start, so this happens only once.
if [ -z "$PD_BB" ]; then
    for bb in /data/adb/ksu/bin/busybox /data/adb/magisk/busybox /data/adb/ap/bin/busybox; do
        [ -x "$bb" ] && PD_BB=1 ASH_STANDALONE=1 exec "$bb" sh "$0" "$@"
    done
fi

# Files are private to root, and package lists are never glob-expanded
umask 077
set -f

DATA_DIR=/data/adb/play-detach
LIST="$DATA_DIR/detach.list"
# Internal storage as seen by root (/sdcard in file managers). Backups go to
# the Play-Detach folder the installer creates, or to Download if it is gone.
STORAGE=/data/media/0
BACKUP_DIR="$STORAGE/Play-Detach"
AUTO_NAME=play-detach-auto.txt
STORE=com.android.vending
# Auto-detach of new sideloaded apps (off unless this file exists)
AUTO_FLAG="$DATA_DIR/auto-detach"
SEEN="$DATA_DIR/seen.list"     # user apps found by the last scan
AUTO_LOG="$DATA_DIR/auto.log"  # "<time> <package>" or "<time> skip <count>"
STORE_FILE="$DATA_DIR/store"   # Play Store version, see scan
NOTIFIED="$DATA_DIR/notified"  # status line already reported as a problem
HOOK_FILE="$DATA_DIR/hook"     # self-check result: "hook=<step> api=<n> at=<loaded>"
HISTORY="$DATA_DIR/history.log" # "<time> <detach|reattach> <source> <package>"
SKIP_FILE="$DATA_DIR/auto-skip" # extra installers whose apps are never auto-detached
# The Play Store side reads at most this many packages / bytes
MAX_PKGS=2048
MAX_BYTES=65536
# Apps installed by these were restored from a backup, not sideloaded on
# purpose, so they are never detached automatically.
RESTORERS=" com.android.vending com.miui.backup org.swiftapps.swiftbackup com.machiav3lli.backup "
MAX_AUTO=5 # more new apps than this in one scan = probably a restore, skip

die() {
    echo "Error: $*" >&2
    exit 1
}

usage() {
    cat <<EOF
Play Detach - stop the Play Store from updating chosen apps

Usage: play-detach <command> [package...]

Commands:
  list              Show detached packages
  add <pkg...>      Detach packages
  remove <pkg...>   Re-attach packages
  set [pkg...]      Replace the whole list (no packages = clear)
  clear             Re-attach everything
  import <file>     Detach packages listed in a file (one per line)
  status            Show whether the module works in the Play Store
  backup [file]     Save the list (default: Play-Detach/play-detach-backup.txt)
  restore [file]    Replace the list with a backup
  autobackup [on|off]
                    Show or change the automatic backup
  autodetach [on|off]
                    Show or change the automatic detach of new sideloaded
                    apps (APK files, other stores, patched apps)
  autoskip [add|remove <installer>]
                    Show or change the installers whose apps are never
                    detached automatically
  history [n]       Show the last n changes of the list (default 20)
  scan              Look for newly installed apps now (also runs on its own)
  help              Show this help

Changes apply right away. The Play Store is restarted, no reboot needed.
Each change also saves Play-Detach/play-detach-auto.txt (automatic backup).
EOF
}

# Language of notifications: the one chosen in the WebUI (EN / RU switch).
# The command line itself stays in English.
ui_lang() {
    case "$(cat "$DATA_DIR/lang" 2>/dev/null)" in
        ru) echo ru ;;
        *) echo en ;;
    esac
}

# Quotes a string for sh -c
shq() {
    printf "'%s'" "$(echo "$1" | sed "s/'/'\\\\''/g")"
}

# notify <tag> <english> <russian>: a notification from the system shell.
# The same tag replaces the previous notification. Posted as the shell user
# (uid 2000): a notification posted as root is accepted but never shown.
# Best effort only.
notify() {
    if [ "$(ui_lang)" = ru ]; then text=$3; else text=$2; fi
    su 2000 -c "cmd notification post -S bigtext -t 'Play Detach' $(shq "$1") $(shq "$text")" >/dev/null 2>&1 ||
        cmd notification post -S bigtext -t 'Play Detach' "$1" "$text" >/dev/null 2>&1
}

valid_pkg() {
    case "$1" in
        '' | .* | *..* | *[!A-Za-z0-9._]*) return 1 ;;
    esac
    [ ${#1} -le 255 ]
}

check_pkgs() {
    for p in "$@"; do
        valid_pkg "$p" || die "invalid package name: '$p'"
    done
}

# Prints the package lines of a file (no blanks or comments) after checking
# each whole line, so "com.a com.b" on one line is rejected.
read_pkg_file() {
    out=$(tr -d '\r' <"$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' -e '/^#/d')
    old_ifs=$IFS
    IFS='
'
    for p in $out; do
        valid_pkg "$p" || {
            IFS=$old_ifs
            die "invalid package name in $1: '$p'"
        }
    done
    IFS=$old_ifs
    printf '%s\n' "$out"
}

# Prints the current list, one package per line, without blanks or comments.
read_list() {
    [ -f "$LIST" ] || return 0
    tr -d '\r' <"$LIST" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' -e '/^#/d'
}

# Locks are directories (mkdir is atomic). They are removed when the command
# ends, and one older than $3 seconds is left over from a killed command.
LOCKS=
cleanup() {
    for l in $LOCKS; do rm -rf "$l"; done
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP

# take_lock <dir> <tries, 0.1 s apart> <stale after seconds>
take_lock() {
    l=$1
    tries=$2
    mkdir -p "$DATA_DIR" 2>/dev/null
    while ! mkdir "$l" 2>/dev/null; do
        now=$(date +%s)
        age=$((now - $(stat -c %Y "$l" 2>/dev/null || echo "$now")))
        if [ "$age" -gt "$3" ]; then
            rm -rf "$l"
            continue
        fi
        [ "$tries" -gt 0 ] || return 1
        tries=$((tries - 1))
        sleep 0.1
    done
    LOCKS="$LOCKS $l"
}

# Every change of the list holds this lock from reading the old list to
# writing the new one, so two changes at the same moment never lose one.
list_lock() {
    take_lock "$DATA_DIR/list.lock" 100 30 || die "the list is busy, try again"
}

# Appends what changed between the old list file $2 and the new one $3 to
# the history, in one awk run. The history is cut to its last 200 lines by
# scan (trim_history), so a change costs no extra step for that.
log_changes() {
    awk -v now="$(date +%s)" -v src="$1" '
        { sub(/\r$/, ""); sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "") }
        $0 == "" || /^#/ { next }
        FILENAME == ARGV[1] { old[$0] = 1; next }
        { new[$0] = 1; if (!($0 in old)) print now " detach " src " " $0 }
        END { for (p in old) if (!(p in new)) print now " reattach " src " " p }
    ' "$2" "$3" >>"$HISTORY" 2>/dev/null
}

trim_history() {
    [ -f "$HISTORY" ] || return 0
    if [ "$(wc -l <"$HISTORY")" -gt 200 ]; then
        tail -n 200 "$HISTORY" >"$HISTORY.tmp.$$" && mv -f "$HISTORY.tmp.$$" "$HISTORY"
    fi
}

# Replaces the list with stdin (sorted, unique) using an atomic rename, so the
# Play Store never reads a half-written file. $1 = who changed it (user, auto,
# import, restore), kept in the history. Callers hold list_lock and must
# check the result: in a pipeline die only ends this function's subshell.
write_list() {
    mkdir -p "$DATA_DIR" || die "cannot create $DATA_DIR"
    chmod 700 "$DATA_DIR"
    tmp="$LIST.tmp.$$"
    sort -u >"$tmp" || {
        rm -f "$tmp"
        die "cannot write $tmp"
    }
    # shellcheck disable=SC2046 # "lines bytes"
    set -- "${1:-user}" $(wc -lc <"$tmp")
    if [ "$2" -gt "$MAX_PKGS" ] || [ "$3" -gt "$MAX_BYTES" ]; then
        rm -f "$tmp"
        die "too many packages: $2 (the Play Store side reads at most $MAX_PKGS, 64 KB)"
    fi
    # Old list vs new one, before the new one replaces it
    if [ -f "$LIST" ]; then log_changes "$1" "$LIST" "$tmp"; else log_changes "$1" /dev/null "$tmp"; fi
    chmod 600 "$tmp"
    mv -f "$tmp" "$LIST" || {
        rm -f "$tmp"
        die "cannot update $LIST"
    }
}

backup_dir() {
    if [ -d "$BACKUP_DIR" ]; then echo "$BACKUP_DIR"; else echo "$STORAGE/Download"; fi
}

# Saves the current list to a file. Prints an error and returns 1 on failure.
save_backup() {
    file=$1
    dir=$(dirname "$file")
    [ -d "$dir" ] || {
        echo "Error: folder not found: $dir" >&2
        return 1
    }
    count=$(read_list | wc -l)
    tmp="$file.tmp.$$"
    {
        echo "# Play Detach backup, $(date '+%Y-%m-%d %H:%M'), $count package(s)"
        read_list
    } >"$tmp" 2>/dev/null && mv -f "$tmp" "$file" || {
        rm -f "$tmp"
        echo "Error: cannot write $file" >&2
        return 1
    }
    # Same owner as the folder, so file managers and apps can read it
    chown "$(stat -c %u:%g "$dir")" "$file" 2>/dev/null
    chmod 664 "$file"
}

# Keeps a copy of the list after every change. An empty list never replaces
# a good copy.
auto_backup() {
    [ -f "$DATA_DIR/no-auto-backup" ] && return 0
    [ "$(read_list | wc -l)" -gt 0 ] || return 0
    save_backup "$(backup_dir)/$AUTO_NAME" 2>/dev/null
    return 0
}

# Runs in the background so the caller (WebUI or terminal) is not kept waiting.
restart_store() {
    am force-stop "$STORE" >/dev/null 2>&1 &
}

# Prints a variable line by line without passing it as a command argument
# (printf is an external program in the Android shell, with a size limit).
lines_of() {
    cat <<EOF_LINES
$1
EOF_LINES
}

# Self-check: the module logs one line in every Play Store process, either
# "active in Play Store ... API <n>" or the step that failed. Right after the
# Play Store starts (status file changed) that line is read from the log and
# the result is kept in $HOOK_FILE, so it does not depend on the log later
# (the log drops old lines while the phone sleeps).
# Prints "<step> <api>" for the newest module line at or after time $1.
hook_from_log() {
    since=$(($1 - 2))
    step=
    level=0
    logcat -d -v epoch -s PlayDetach 2>/dev/null | {
        while read -r ts _pid _tid lvl rest; do
            sec=${ts%%.*}
            case "$sec" in '' | *[!0-9]*) continue ;; esac
            [ "$sec" -ge "$since" ] || continue
            case "$lvl $rest" in
                "I "*"active in Play Store"*)
                    step=ok
                    level=${rest##*API }
                    ;;
                "E "*"Android API level"*) step=api ;;
                "E "*"not found"*) step=field ;;
                "E "*"libbinder.so"*) step=binder ;;
                "E "*"PLT hook"*) step=plt ;;
                "E "*) step=list ;;
            esac
        done
        case "$level" in '' | *[!0-9]*) level=0 ;; esac
        [ -n "$step" ] && echo "$step $level"
    }
}

# Reads the one-line status file the module writes each time the Play Store
# starts, and the self-check result for that start. Sets loaded, packages,
# hook (ok | api | field | binder | plt | list | unknown) and api.
read_status() {
    loaded=0
    packages=0
    hook=unknown
    api=0
    [ -f "$DATA_DIR/status" ] || return 0
    for kv in $(cat "$DATA_DIR/status"); do
        case "$kv" in
            loaded=*) loaded=${kv#loaded=} ;;
            packages=*) packages=${kv#packages=} ;;
        esac
    done
    case "$loaded" in '' | *[!0-9]*) loaded=0 ;; esac
    [ "$loaded" -gt 0 ] || return 0

    at=0
    h=
    a=0
    if [ -f "$HOOK_FILE" ]; then
        for kv in $(cat "$HOOK_FILE"); do
            case "$kv" in
                hook=*) h=${kv#hook=} ;;
                api=*) a=${kv#api=} ;;
                at=*) at=${kv#at=} ;;
            esac
        done
    fi
    if [ "$at" != "$loaded" ]; then
        # Not checked yet for this start: read the log now (slow: the whole
        # log is filtered, about 2 s on a full log)
        res=$(hook_from_log "$loaded")
        if [ -z "$res" ]; then
            # No line yet. A minute after the start it will not come any
            # more: remember "unknown", so the log is not read on every call.
            [ $(($(date +%s) - loaded)) -gt 60 ] || return 0
            res="unknown 0"
        fi
        h=${res% *}
        a=${res#* }
        echo "hook=$h api=$a at=$loaded" >"$HOOK_FILE.tmp.$$" && mv -f "$HOOK_FILE.tmp.$$" "$HOOK_FILE"
    fi
    hook=$h
    api=$a
}

# Reads the Play Store version saved by scan. Sets store_code, store_name,
# store_changed (0 = not changed since it was first seen).
read_store() {
    store_code=
    store_name=
    store_changed=0
    [ -f "$STORE_FILE" ] || return 0
    for kv in $(cat "$STORE_FILE"); do
        case "$kv" in
            code=*) store_code=${kv#code=} ;;
            name=*) store_name=${kv#name=} ;;
            changed=*) store_changed=${kv#changed=} ;;
        esac
    done
}

# Saves the Play Store version and when it last changed, so the WebUI can
# tell that the Play Store was updated and check the module afterwards.
scan_store() {
    # The dump is too big for a command argument (printf is not built into
    # the Android shell), so it is piped straight into sed.
    vals=$(dumpsys package "$STORE" 2>/dev/null |
        sed -n -e 's/.*versionCode=\([0-9][0-9]*\).*/C \1/p' -e 's/.*versionName=\([^ ]*\).*/N \1/p')
    code=$(lines_of "$vals" | sed -n 's/^C //p' | head -n 1)
    name=$(lines_of "$vals" | sed -n 's/^N //p' | head -n 1)
    [ -n "$code" ] || return 0
    read_store
    if [ -z "$store_code" ]; then
        changed=0
    elif [ "$store_code" != "$code" ]; then
        changed=$(date +%s)
    else
        changed=$store_changed
    fi
    [ "$store_code" = "$code" ] && [ "$store_name" = "$name" ] && return 0
    echo "code=$code name=${name:-?} changed=$changed" >"$STORE_FILE.tmp.$$" &&
        mv -f "$STORE_FILE.tmp.$$" "$STORE_FILE"
}

# Prints "package installer" for every user app.
user_apps() {
    pm list packages -3 -i 2>/dev/null |
        sed -n 's/^package:\([^[:space:]]*\)[[:space:]]*installer=\([^[:space:]]*\).*/\1 \2/p'
}

# Finds user apps that were not there at the last scan. With auto-detach on,
# new sideloaded apps are detached. "scan_apps snapshot" only remembers the
# current apps (used when auto-detach is turned on, so nothing old is touched).
scan_apps() {
    cur=$(user_apps)
    [ -n "$cur" ] || return 0 # package manager not ready, try next time
    found=
    kept=
    n=0
    if [ "$1" != snapshot ] && [ -f "$SEEN" ] && [ -f "$AUTO_FLAG" ]; then
        detached=$(read_list)
        skip=" $RESTORERS $(tr '\n' ' ' 2>/dev/null <"$SKIP_FILE") "
        old_ifs=$IFS
        IFS='
'
        for line in $cur; do
            pkg=${line%% *}
            inst=${line#* }
            valid_pkg "$pkg" || continue
            grep -qxF "$pkg" "$SEEN" && continue
            case "$skip" in *" $inst "*) continue ;; esac
            n=$((n + 1))
            # Removed and installed again while still on the list: it stays
            # detached, only reported
            if lines_of "$detached" | grep -qxF "$pkg"; then
                kept="$kept $pkg"
            else
                found="$found $pkg"
            fi
        done
        IFS=$old_ifs
    fi

    # Apps that were removed leave the automatic detach log
    if [ -s "$AUTO_LOG" ] && [ -f "$SEEN" ]; then
        names=$(lines_of "$cur" | cut -d' ' -f1)
        keep=$(while read -r ts what; do
            case "$what" in
                skip\ *) echo "$ts $what" ;;
                *) lines_of "$names" | grep -qxF "$what" && echo "$ts $what" ;;
            esac
        done <"$AUTO_LOG")
        if [ "$keep" != "$(cat "$AUTO_LOG")" ]; then
            if [ -n "$keep" ]; then lines_of "$keep" >"$AUTO_LOG.tmp.$$"; else : >"$AUTO_LOG.tmp.$$"; fi
            mv -f "$AUTO_LOG.tmp.$$" "$AUTO_LOG"
        fi
    fi

    # Remember the current apps before acting, so a failure never repeats.
    # Written only when an app was installed or removed: the WebUI reads its
    # time to see that the app list changed.
    lines_of "$cur" | cut -d' ' -f1 | sed '/^$/d' | sort -u >"$SEEN.tmp.$$"
    if cmp -s "$SEEN.tmp.$$" "$SEEN"; then
        rm -f "$SEEN.tmp.$$"
    else
        mv -f "$SEEN.tmp.$$" "$SEEN"
        chmod 600 "$SEEN" 2>/dev/null
    fi

    [ "$n" -gt 0 ] || return 0
    now=$(date +%s)
    if [ "$n" -gt "$MAX_AUTO" ]; then
        echo "$now skip $n" >>"$AUTO_LOG"
        notify play-detach-auto \
            "$n new apps were installed at once, probably restored from a backup. They were not detached automatically. Open Play Detach to check them." \
            "Сразу установлено $n новых приложений, вероятно восстановление из бэкапа. Они не откреплены автоматически. Проверьте их в Play Detach."
    else
        if [ -n "$found" ]; then
            list_lock
            # shellcheck disable=SC2086 # $found is a list of checked package names
            { read_list; printf '%s\n' $found; } | write_list auto || return 1
            auto_backup
            restart_store
        fi
        for p in $found $kept; do echo "$now $p" >>"$AUTO_LOG"; done
        en=
        ru=
        if [ -n "$found" ]; then
            names=$(echo $found | sed 's/ /, /g')
            en="Detached automatically: $names. "
            ru="Откреплено автоматически: $names. "
            echo "Detached automatically:$found"
        fi
        if [ -n "$kept" ]; then
            names=$(echo $kept | sed 's/ /, /g')
            en="${en}Installed again and still detached: $names. "
            ru="${ru}Установлено заново и по-прежнему откреплено: $names. "
            echo "Still detached:$kept"
        fi
        notify play-detach-auto \
            "${en}New apps installed outside the Play Store get no Play Store updates. Open Play Detach to undo." \
            "${ru}Новые приложения, установленные вне Маркета, не обновляются через Play Маркет. Отменить можно в Play Detach."
    fi
    chmod 600 "$AUTO_LOG"
    # Keep the log short
    if [ "$(wc -l <"$AUTO_LOG")" -gt 30 ]; then
        tail -n 30 "$AUTO_LOG" >"$AUTO_LOG.tmp.$$" && mv -f "$AUTO_LOG.tmp.$$" "$AUTO_LOG"
    fi
}

# Only one scan at a time (the background watcher and a manual scan). A lock
# older than two minutes is left over from a killed scan and is ignored.
scan_lock() {
    take_lock "$DATA_DIR/scan.lock" 0 120
}

# Start time (epoch) of the running Play Store, 0 if it does not run.
store_started() {
    pid=$(pidof "$STORE" 2>/dev/null)
    pid=${pid%% *}
    sl=
    [ -n "$pid" ] && read -r sl 2>/dev/null <"/proc/$pid/stat"
    [ -n "$sl" ] || {
        echo 0
        return
    }
    # shellcheck disable=SC2086 # word splitting of /proc/<pid>/stat is wanted
    set -- $sl
    # field 22 = start time in clock ticks after boot (100 per second)
    echo $((boot + ${22} / 100))
}

# Name and version of the active Zygisk, "none" if none was found.
# rezygisk = ReZygisk; zygisksu = Zygisk Next and NeoZygisk (same module id,
# the name comes from their module.prop); zygisknextsu = a Zygisk Next fork.
zygisk_name() {
    for id in rezygisk zygisksu zygisknextsu; do
        d=/data/adb/modules/$id
        [ -f "$d/module.prop" ] && [ ! -f "$d/disable" ] && [ ! -f "$d/remove" ] || continue
        n=
        v=
        while IFS= read -r line; do
            case "$line" in
                name=*) [ -n "$n" ] || n=${line#name=} ;;
                version=*) [ -n "$v" ] || v=${line#version=} ;;
            esac
        done <"$d/module.prop"
        echo "${n:-$id} $v"
        return
    done
    if command -v magisk >/dev/null 2>&1 &&
        [ "$(magisk --sqlite "SELECT value FROM settings WHERE key='zygisk'" 2>/dev/null)" = value=1 ]; then
        echo "Magisk Zygisk"
        return
    fi
    echo none
}

# Notifies once when the module stops working in the Play Store (for example
# after a Play Store or Android update), and again only after it worked.
check_hook() {
    read_status
    case "$hook" in
        ok)
            rm -f "$NOTIFIED"
            return 0
            ;;
        unknown) return 0 ;;
    esac
    [ "$(cat "$NOTIFIED" 2>/dev/null)" = "$hook" ] && return 0
    echo "$hook" >"$NOTIFIED"
    notify play-detach-check \
        "Play Detach does not work in the Play Store right now (step: $hook), probably after a Play Store or Android update. Detached apps can get updates again. Open Play Detach for details." \
        "Play Detach сейчас не работает в Play Маркете (шаг: $hook), вероятно после обновления Play Маркета или Android. Откреплённые приложения снова могут обновиться. Подробности в Play Detach."
}

[ "$(id -u)" = 0 ] || die "root is required, run: su -c '/data/adb/modules/play-detach/play-detach $*'"

cmd="$1"
[ $# -gt 0 ] && shift

case "$cmd" in
    list)
        read_list
        ;;
    add)
        [ $# -gt 0 ] || die "no package given"
        check_pkgs "$@"
        list_lock
        { read_list; printf '%s\n' "$@"; } | write_list user || exit 1
        auto_backup
        restart_store
        for p in "$@"; do echo "Detached: $p"; done
        ;;
    remove)
        [ $# -gt 0 ] || die "no package given"
        check_pkgs "$@"
        list_lock
        current=$(read_list)
        for p in "$@"; do
            current=$(printf '%s\n' "$current" | grep -vxF "$p")
        done
        printf '%s\n' "$current" | sed '/^$/d' | write_list user || exit 1
        auto_backup
        restart_store
        for p in "$@"; do echo "Re-attached: $p"; done
        ;;
    set)
        check_pkgs "$@"
        list_lock
        if [ $# -gt 0 ]; then printf '%s\n' "$@"; else :; fi | write_list user || exit 1
        auto_backup
        restart_store
        echo "Detached $# package(s)"
        ;;
    clear)
        list_lock
        : | write_list user || exit 1
        restart_store
        echo "All apps re-attached"
        ;;
    import)
        [ -f "$1" ] || die "file not found: $1"
        pkgs=$(read_pkg_file "$1") || exit 1
        [ -n "$pkgs" ] || die "no packages in $1"
        list_lock
        { read_list; lines_of "$pkgs"; } | write_list import || exit 1
        auto_backup
        restart_store
        echo "Imported $(printf '%s\n' "$pkgs" | wc -l) package(s)"
        ;;
    status)
        # status is written by the module each time the Play Store starts
        read_status
        read_store
        list_time=$(stat -c %Y "$LIST" 2>/dev/null || echo 0)
        count=$(read_list | wc -l)
        read -r up _ </proc/uptime
        boot=$(($(date +%s) - ${up%.*}))
        started=$(store_started)
        # The running Play Store started after the list was saved, but the
        # module did not report from it: Zygisk did not load the module.
        notloaded=0
        if [ "$count" -gt 0 ] && [ "$started" -gt 0 ] && [ "$list_time" -lt "$started" ] &&
            [ "$loaded" -lt $((started - 5)) ]; then
            notloaded=1
        fi
        echo "loaded=$loaded"
        echo "loaded_packages=$packages"
        echo "list_changed=$list_time"
        echo "detached=$count"
        echo "hook=$hook"
        echo "api=$api"
        echo "store_version=${store_name:-unknown}"
        echo "store_changed=$store_changed"
        if [ -f "$AUTO_FLAG" ]; then echo "autodetach=on"; else echo "autodetach=off"; fi
        echo "apps_changed=$(stat -c %Y "$SEEN" 2>/dev/null || echo 0)"
        echo "history_changed=$(stat -c %Y "$HISTORY" 2>/dev/null || echo 0)"
        echo "boot=$boot"
        echo "store_started=$started"
        echo "not_loaded=$notloaded"
        echo "zygisk=$(zygisk_name)"
        if [ "$hook" != ok ] && [ "$hook" != unknown ]; then
            echo "Problem: the module could not start in the Play Store (step: $hook)."
        elif [ "$notloaded" = 1 ]; then
            echo "Problem: the module did not load in the running Play Store. Is Zygisk active?"
        elif [ "$loaded" -eq 0 ]; then
            echo "The Play Store has not loaded the list yet."
        elif [ "$store_changed" -gt "$loaded" ]; then
            echo "The Play Store was updated, the module is checked when it opens."
        elif [ "$loaded" -ge "$list_time" ]; then
            echo "Active: the Play Store uses the current list."
        else
            echo "The list changed, it applies when the Play Store opens."
        fi
        ;;
    backup)
        file="${1:-$(backup_dir)/play-detach-backup.txt}"
        save_backup "$file" || exit 1
        echo "Saved $(read_list | wc -l) package(s) to $file"
        ;;
    restore)
        file="${1:-$(backup_dir)/play-detach-backup.txt}"
        [ -f "$file" ] || die "backup not found: $file"
        pkgs=$(read_pkg_file "$file") || exit 1
        list_lock
        lines_of "$pkgs" | sed '/^$/d' | write_list restore || exit 1
        auto_backup
        restart_store
        echo "Restored $(read_list | wc -l) package(s) from $file"
        ;;
    autobackup)
        case "$1" in
            on) rm -f "$DATA_DIR/no-auto-backup" && auto_backup ;;
            off) mkdir -p "$DATA_DIR" && touch "$DATA_DIR/no-auto-backup" ;;
            '') ;;
            *) die "use: autobackup [on|off]" ;;
        esac
        if [ -f "$DATA_DIR/no-auto-backup" ]; then
            echo "Automatic backup: off"
        else
            echo "Automatic backup: on, $(backup_dir)/$AUTO_NAME"
        fi
        ;;
    autodetach)
        case "$1" in
            on)
                mkdir -p "$DATA_DIR" && touch "$AUTO_FLAG"
                # Remember the apps installed now: only apps installed from
                # here on are detached automatically.
                scan_lock && scan_apps snapshot
                ;;
            off) rm -f "$AUTO_FLAG" ;;
            '') ;;
            *) die "use: autodetach [on|off]" ;;
        esac
        if [ -f "$AUTO_FLAG" ]; then
            echo "Auto-detach: on"
        else
            echo "Auto-detach: off"
        fi
        ;;
    history)
        n=${1:-20}
        case "$n" in '' | *[!0-9]*) die "use: history [count]" ;; esac
        [ -f "$HISTORY" ] && tail -n "$n" "$HISTORY"
        ;;
    autoskip)
        case "$1" in
            add | remove)
                [ -n "$2" ] && valid_pkg "$2" || die "invalid installer name: '$2'"
                take_lock "$DATA_DIR/skip.lock" 50 30 || die "busy, try again"
                {
                    cat "$SKIP_FILE" 2>/dev/null
                    [ "$1" = add ] && echo "$2"
                } | sed '/^$/d' | sort -u | { if [ "$1" = remove ]; then grep -vxF "$2"; else cat; fi; } >"$SKIP_FILE.tmp.$$"
                mv -f "$SKIP_FILE.tmp.$$" "$SKIP_FILE" || die "cannot write $SKIP_FILE"
                ;;
            '' | list) ;;
            *) die "use: autoskip [add|remove <installer>]" ;;
        esac
        cat "$SKIP_FILE" 2>/dev/null
        exit 0
        ;;
    scan)
        mkdir -p "$DATA_DIR"
        scan_lock || die "a scan is already running"
        scan_store
        scan_apps
        trim_history
        echo "Scan done, auto-detach is $([ -f "$AUTO_FLAG" ] && echo on || echo off)"
        ;;
    check)
        # Used by the background watcher after the status file changes
        check_hook
        ;;
    help | -h | --help | '')
        usage
        ;;
    *)
        usage >&2
        die "unknown command: $cmd"
        ;;
esac
